{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first knowledge OS with AI agents: Markdown vaults, knowledge graph, project indexing and verifiable multi-agent workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/core",
    "apps/server",
    "apps/ui",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build -w @aos/ui && npm run build -w @aos/server",
    "start": "node apps/server/dist/aos.mjs serve",
    "dev:server": "npm run dev -w @aos/server",
    "typecheck": "tsc -b packages/core apps/server && tsc -p apps/ui --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ui": "npm run watch -w @aos/ui"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasha2011polyakov-dot/Agentic-Os.git"
  },
  "homepage": "https://github.com/sasha2011polyakov-dot/Agentic-Os#readme",
  "bugs": {
    "url": "https://github.com/sasha2011polyakov-dot/Agentic-Os/issues"
  }
}
