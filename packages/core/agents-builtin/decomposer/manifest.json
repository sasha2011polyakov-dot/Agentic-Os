{
  "formatVersion": 1,
  "id": "decomposer",
  "name": "Декомпозитор",
  "version": "1.0.0",
  "description": "Превращает требования в иерархию реализуемых задач с зависимостями и критериями завершения.",
  "author": "Agentic OS",
  "category": "spec",
  "entry": "instructions.md",
  "platform": ">=0.1.0 <1.0.0",
  "schemas": {
    "input": "schemas/input.schema.json",
    "output": "schemas/output.schema.json"
  },
  "tools": "tools.json",
  "permissions": [],
  "dependencies": [],
  "model": {
    "taskType": "planning",
    "structuredOutput": "preferred"
  },
  "defaults": {
    "temperature": 0.2,
    "maxOutputTokens": 8000,
    "maxToolRounds": 4,
    "repairAttempts": 2
  }
}
