{
  "formatVersion": 1,
  "id": "project-explorer",
  "name": "Project explorer",
  "version": "1.0.1",
  "description": "Explores connected projects and the knowledge base: architecture, existing solutions, relevant files.",
  "author": "Agentic OS",
  "category": "mission",
  "entry": "instructions.md",
  "platform": ">=0.1.0 <1.0.0",
  "schemas": {
    "input": "schemas/input.schema.json",
    "output": "schemas/output.schema.json"
  },
  "tools": "tools.json",
  "permissions": [
    {
      "permission": "projects.read",
      "reason": "Read the project"
    },
    {
      "permission": "search.use",
      "reason": "Search"
    },
    {
      "permission": "documents.read",
      "reason": "Read documents"
    },
    {
      "permission": "graph.read",
      "reason": "Document links"
    },
    {
      "permission": "systems.read",
      "reason": "Read other systems explicitly selected for the mission (results show which system they come from)"
    }
  ],
  "dependencies": [],
  "model": {
    "taskType": "extraction",
    "structuredOutput": "preferred",
    "minContext": 8192
  },
  "defaults": {
    "temperature": 0.2,
    "maxOutputTokens": 6000,
    "maxToolRounds": 6,
    "repairAttempts": 2
  }
}
