{
  "formatVersion": 1,
  "id": "implementer",
  "name": "Implementer",
  "version": "1.0.1",
  "description": "Executes a plan step: prepares file changes (change sets) and documents, and runs allowed checks.",
  "author": "Agentic OS",
  "category": "mission",
  "entry": "instructions.md",
  "platform": ">=0.1.0 <1.0.0",
  "schemas": {
    "input": "schemas/input.schema.json",
    "output": "schemas/output.schema.json"
  },
  "tools": "tools.json",
  "permissions": [
    {
      "permission": "documents.read",
      "reason": "Read documents"
    },
    {
      "permission": "projects.read",
      "reason": "Read code"
    },
    {
      "permission": "search.use",
      "reason": "Search"
    },
    {
      "permission": "changes.propose",
      "reason": "Prepare change sets"
    },
    {
      "permission": "documents.create",
      "reason": "Create documents with the results",
      "scope": {
        "folders": [
          "Reports",
          "Specs",
          "Research",
          "Notes",
          "Missions",
          "Docs"
        ]
      }
    },
    {
      "permission": "commands.run",
      "reason": "Run the checks set by the user"
    },
    {
      "permission": "agents.create",
      "reason": "Drafts of specialized agents when no suitable one exists (only the user enables them)"
    },
    {
      "permission": "workflows.create",
      "reason": "Drafts of workflows for repeated tasks (only the user runs them)"
    }
  ],
  "dependencies": [],
  "model": {
    "taskType": "generation",
    "structuredOutput": "preferred",
    "minContext": 16384
  },
  "defaults": {
    "temperature": 0.2,
    "maxOutputTokens": 12000,
    "maxToolRounds": 8,
    "repairAttempts": 2
  }
}
