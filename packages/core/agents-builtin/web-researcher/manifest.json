{
  "formatVersion": 1,
  "id": "web-researcher",
  "name": "Web researcher",
  "version": "1.0.1",
  "description": "Finds and reads sources on the internet, extracts claims with verbatim quotes and verifies them in code.",
  "author": "Agentic OS",
  "category": "research",
  "entry": "instructions.md",
  "platform": ">=0.1.0 <1.0.0",
  "schemas": {
    "input": "schemas/input.schema.json",
    "output": "schemas/output.schema.json"
  },
  "tools": "tools.json",
  "permissions": [
    {
      "permission": "web.search",
      "reason": "Find sources"
    },
    {
      "permission": "network.fetch",
      "reason": "Download public pages"
    },
    {
      "permission": "external.api",
      "reason": "GitHub API to find repositories"
    },
    {
      "permission": "search.use",
      "reason": "Check what is already known locally"
    },
    {
      "permission": "documents.read",
      "reason": "Read local notes on the topic"
    }
  ],
  "dependencies": [],
  "model": {
    "taskType": "research",
    "structuredOutput": "preferred",
    "minContext": 16384
  },
  "defaults": {
    "temperature": 0.2,
    "maxOutputTokens": 8000,
    "maxToolRounds": 6,
    "repairAttempts": 2
  }
}
