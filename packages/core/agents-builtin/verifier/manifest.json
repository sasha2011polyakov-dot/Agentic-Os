{
  "formatVersion": 1,
  "id": "verifier",
  "name": "Result verifier",
  "version": "1.0.1",
  "description": "Compares the actual result with the acceptance criteria and the check results.",
  "author": "Agentic OS",
  "category": "mission",
  "entry": "instructions.md",
  "platform": ">=0.1.0 <1.0.0",
  "schemas": {
    "input": "schemas/input.schema.json",
    "output": "schemas/output.schema.json"
  },
  "tools": "tools.json",
  "permissions": [
    {
      "permission": "documents.read",
      "reason": "Read artifacts"
    },
    {
      "permission": "projects.read",
      "reason": "Read changed files"
    },
    {
      "permission": "search.use",
      "reason": "Search"
    },
    {
      "permission": "commands.run",
      "reason": "Re-run the checks set by the user"
    }
  ],
  "dependencies": [],
  "model": {
    "taskType": "review",
    "structuredOutput": "preferred"
  },
  "defaults": {
    "temperature": 0.2,
    "maxOutputTokens": 4000,
    "maxToolRounds": 4,
    "repairAttempts": 2
  }
}
