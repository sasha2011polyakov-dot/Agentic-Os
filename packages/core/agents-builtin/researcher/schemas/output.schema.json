{
  "type": "object",
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Evidence ID such as E1, E2…",
            "pattern": "^E[0-9]+$"
          },
          "fact": {
            "type": "string",
            "description": "A fact or claim in one sentence"
          },
          "kind": {
            "enum": [
              "fact",
              "assumption"
            ],
            "description": "fact: confirmed by a source; assumption: an assumption"
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "document",
                  "project_file"
                ]
              },
              "ref": {
                "type": "string",
                "description": "A docId or \"sourceId:path\""
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "ref",
              "title"
            ]
          },
          "quote": {
            "type": "string",
            "description": "A verbatim quote from the source (required for fact)"
          },
          "relevance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_verification": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "fact",
          "kind",
          "source",
          "quote",
          "relevance",
          "confidence",
          "needs_verification"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "evidence",
    "gaps"
  ]
}
