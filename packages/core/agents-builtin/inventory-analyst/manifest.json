{
  "formatVersion": 1,
  "id": "inventory-analyst",
  "name": "Project inventory analyst",
  "version": "1.0.1",
  "description": "Builds a reliable map of the project structure from the deterministic inventory and by reading key files.",
  "author": "Agentic OS",
  "category": "spec",
  "entry": "instructions.md",
  "platform": ">=0.1.0 <1.0.0",
  "schemas": {
    "input": "schemas/input.schema.json",
    "output": "schemas/output.schema.json"
  },
  "tools": "tools.json",
  "permissions": [
    {
      "permission": "projects.read",
      "reason": "Read files of connected projects to build the map"
    },
    {
      "permission": "documents.read",
      "reason": "Read selected documents"
    }
  ],
  "dependencies": [],
  "model": {
    "taskType": "extraction",
    "structuredOutput": "preferred"
  },
  "defaults": {
    "temperature": 0.2,
    "maxOutputTokens": 4000,
    "maxToolRounds": 3,
    "repairAttempts": 2
  }
}
