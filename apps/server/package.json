{
  "name": "@aos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local HTTP API and CLI for Agentic OS (binds to 127.0.0.1 only).",
  "bin": {
    "aos": "dist/aos.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node dist/aos.mjs serve --dev",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@aos/core": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "license": "Apache-2.0"
}
